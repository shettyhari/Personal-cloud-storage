# Personal Cloud OS - bootstrap configuration.
# Everything else (storage folders, network allow-list, AI, backups) is configured in the dashboard.
# Secrets are NOT stored here: password hashes and tokens live in the database, backup keys are
# protected with Windows DPAPI in <data dir>\secrets.

# Address the agent listens on.
#   127.0.0.1 (recommended): only this PC. Remote devices reach it via `tailscale serve` (HTTPS).
#   0.0.0.0: all interfaces. The IP allow-list (Settings > Network) still rejects non-Tailscale/non-LAN clients,
#            and Windows Firewall will ask for permission.
PCLOUD_HOST=127.0.0.1
PCLOUD_PORT=8787

# Where the database, logs, recycle bin and versions live (default: %LOCALAPPDATA%\PersonalCloudOS)
# PCLOUD_DATA_DIR=D:\PersonalCloudOS-data

# Set to true when users always reach the server over HTTPS (e.g. tailscale serve) -> Secure cookies + HSTS.
# Leave false if you also open http://127.0.0.1:8787 directly on this PC.
PCLOUD_SECURE_COOKIES=false

# Session lifetime in hours (idle timeout is set in the dashboard)
PCLOUD_SESSION_HOURS=12

# Maximum size of a single upload (bytes). Default 50 GB.
PCLOUD_MAX_UPLOAD_BYTES=53687091200

# Only needed if you host the dashboard on another origin during development.
# PCLOUD_CORS_ORIGINS=http://localhost:3000

# Development: enables /api/docs (OpenAPI)
PCLOUD_DEV=false
